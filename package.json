{
  "name": "taddicons",
  "version": "2.0.0",
  "description": "Taddicons, the official Taddi icon set: thousands of outline icons in one calm style, from interface symbols and every kind of document to specialist icons, as SVG, sprite, webfont, PNG, WebP, AVIF and ICO.",
  "license": "MIT",
  "author": "Taddi (https://taddi.app)",
  "homepage": "https://taddicons.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taddicons/icons.git"
  },
  "bugs": "https://github.com/taddicons/icons/issues",
  "keywords": [
    "icons",
    "icon-set",
    "svg-icons",
    "icon-font",
    "webfont",
    "outline-icons",
    "line-icons",
    "ui-icons",
    "free-icons",
    "documents",
    "taddi",
    "taddicons"
  ],
  "private": true,
  "style": "font/taddicons.css",
  "files": [
    "icons.json",
    "svg",
    "sprite",
    "font",
    "LICENSE"
  ],
  "exports": {
    "./sprite/*": "./sprite/*",
    "./svg/*": "./svg/*",
    "./font/*": "./font/*"
  },
  "scripts": {
    "build": "npm run build:font && npm run build:images && npm run build:docs",
    "build:font": "python3 scripts/build-font.py",
    "build:images": "node scripts/build-images.mjs",
    "build:docs": "node scripts/build-docs.mjs",
    "release": "node scripts/package-release.mjs"
  },
  "devDependencies": {
    "sharp": "0.34.5"
  }
}
